# Copy to .env (never commit .env). Server-side only — nothing here is exposed to the browser.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Set to true for hosted Postgres that requires SSL (Supabase, Neon, Render, etc.)
DATABASE_SSL=false
PORT=8000
# Set to the number of reverse proxies in front of the app (e.g. 1) so rate limiting sees real client IPs.
TRUST_PROXY=0
# Optional: comma-separated allowed browser origins for POST /api/enquiries
ALLOWED_ORIGINS=
# Admin panel: set true when served over HTTPS (defaults to true when NODE_ENV=production)
COOKIE_SECURE=false
# Create staff accounts with: npm run admin:create -- --email you@example.com --name "Your Name" --role ADMIN

# B2B partnership form (Web3Forms). Public by design; must be set at BUILD time (static export).
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Production environment
NODE_ENV=production

# Admin session configuration
# SESSION_SECRET signs admin CSRF tokens. Set a stable value in production
# (e.g. `openssl rand -hex 32`); leaving it empty forces re-login on every restart.
SESSION_SECRET=
ADMIN_SESSION_HOURS=12

# Site configuration
# Canonical origin used for sitemap.xml, robots.txt, canonical/OG tags and JSON-LD.
# NEXT_PUBLIC_* values are inlined at BUILD time, so set this before `npm run build`.
NEXT_PUBLIC_SITE_URL=https://reasons.edu.np

# Database SSL CA certificate (optional, for hosted Postgres with custom CA)
DATABASE_CA_CERT=

# Cloudflare Turnstile (optional, protects the enquiry form).
# The site key is public by design and must also be set at BUILD time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
